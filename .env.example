# Environment Variables for PathFinder AI
# Copy this to .env.local and fill in your values

# OpenAI API Key (required for AI chat features)
# Get your key at: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Connection (optional - for persistence)
# Local: mongodb://localhost:27017/pathfinder
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/pathfinder
MONGODB_URI=

# NextAuth Secret (required for auth)
# Generate one: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional - for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App Configuration
NEXT_PUBLIC_APP_NAME=PathFinder AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
